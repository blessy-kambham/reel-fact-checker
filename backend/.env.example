# Free demo works without copying this file or adding any keys.
# Live research sends submitted text to OpenAI and search queries to Tavily.
# Enable only after reviewing provider billing and setting account spending limits.
ENABLE_LIVE_RESEARCH=false
OPENAI_API_KEY=
# Set a model available in your account that supports Responses structured outputs.
OPENAI_MODEL=
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Daily live-research limits (UTC day). Defaults: 0.50 USD of estimated OpenAI cost and 40 Tavily searches.
# Pricing is built in for gpt-4.1-mini only. Set your provider account limits too.
DAILY_BUDGET_USD=
DAILY_SEARCH_LIMIT=
# Video mode (optional): local Whisper model size (tiny, base, small, medium). Downloads once on first use.
WHISPER_MODEL=
# Access control. Leave empty for local use. Required in production (see docs/DEPLOY.md).
APP_PASSWORD=
SESSION_SECRET=
# Agents: autonomous (default) lets every agent plan its own steps; fixed makes each do one standard pass.
# A list turns planning on for some: orchestrator, content_extractor, claim_extractor, research, analyst,
# citation_verifier, verdict.
AGENT_MODE=
# Reports per person per hour (default 10).
REPORTS_PER_HOUR=
